<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Entry point -->
    <template id="inventory_balance_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wiz">
                <t t-call="custom_inventory_balance_report.report_inventory_balance_document"/>
            </t>
        </t>
    </template>

    <!-- Report body -->
    <template id="report_inventory_balance_document">
        <t t-set="data" t-value="wiz._get_report_data()"/>
        <t t-set="lines" t-value="data['lines']"/>
        <t t-set="totals" t-value="data['totals']"/>
        <t t-set="company" t-value="wiz.company_id"/>

        <div class="article inventory-balance-container">

            <!-- ================= EMBEDDED STYLES ================= -->
            <style>
                @page { size: A4 landscape; margin: 8mm; }
                body, html {
                    margin: 0; padding: 0;
                    font-family: 'DejaVu Sans', Arial, sans-serif;
                    font-size: 7.5pt; color: #212529; background: #fff;
                }
                .inventory-balance-container { width: 100%; box-sizing: border-box; }

                /* ---- Header ---- */
                .rpt-header { width: 100%; border-collapse: collapse; margin-bottom: 6px; }
                .rpt-header td { vertical-align: middle; padding: 4px; }
                .co-logo { max-height: 50px; max-width: 130px; object-fit: contain; }
                .co-name { font-size: 11pt; font-weight: 800; color: #1a3c5e; }
                .rpt-title-box {
                    background: #1a3c5e; color: #fff; text-align: center;
                    padding: 7px 10px; border-radius: 4px;
                }
                .rpt-title-en { font-size: 12pt; font-weight: 800; letter-spacing: .5px; }
                .rpt-title-ar { font-size: 9pt; font-weight: 700; margin-top: 2px; opacity: .95; }
                .rpt-meta { text-align: right; font-size: 8pt; line-height: 1.5; }
                .rpt-meta strong { color: #1a3c5e; }

                /* ---- Meta strip ---- */
                .tbl-meta { width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 7.5pt; }
                .tbl-meta td { padding: 3px 6px; border: 1px solid #d0d7de; }
                .meta-lbl { background: #eef2f6; font-weight: 700; color: #1a3c5e; white-space: nowrap; }
                .meta-val { color: #212529; }

                /* ---- Data table ---- */
                .rpt-table { width: 100%; border-collapse: collapse; font-size: 7pt; }
                .rpt-table thead th {
                    background: #1a3c5e; color: #fff;
                    padding: 5px 4px; text-align: center;
                    border: 1px solid #0f2440; font-weight: 700;
                    font-size: 6.5pt; vertical-align: middle;
                }
                .rpt-table thead th .th-en { display: block; line-height: 1.15; }
                .rpt-table thead th .th-ar { display: block; font-size: 5.8pt; direction: rtl; margin-top: 1px; opacity: .9; }
                .rpt-table tbody td {
                    padding: 4px 5px; border: 1px solid #d0d7de;
                    vertical-align: middle; color: #212529;
                }
                .rpt-table tbody tr:nth-child(even) { background: #f5f7fa; }
                .rpt-table .c-product { text-align: left; padding-left: 6px !important; }
                .rpt-table .c-num { text-align: right; white-space: nowrap; }
                .uom-hint { color: #888; font-size: 6pt; }

                /* ---- Totals row ---- */
                .rpt-table tfoot td {
                    background: #2e7d32; color: #fff;
                    font-weight: 800; padding: 5px 6px;
                    border: 1px solid #1b5e20; font-size: 7.5pt;
                }
                .rpt-table tfoot .c-num { text-align: right; }

                /* ---- Footer ---- */
                .rpt-footer {
                    margin-top: 8px; font-size: 6.5pt; color: #666;
                    text-align: center; line-height: 1.4;
                }
                .rpt-footer .ar { direction: rtl; }
            </style>

            <!-- ================= HEADER ================= -->
            <table class="rpt-header">
                <tr>
                    <td style="width:28%;">
                        <t t-if="company and company.logo">
                            <img t-att-src="image_data_uri(company.logo)" class="co-logo" alt="Logo"/>
                        </t>
                        <div class="co-name"><t t-esc="company.name if company else ''"/></div>
                    </td>
                    <td style="width:44%;">
                        <div class="rpt-title-box">
                            <div class="rpt-title-en">Inventory Balance &amp; Sales Movement Report</div>
                            <div class="rpt-title-ar">تقرير رصيد وحركة المخزون</div>
                        </div>
                    </td>
                    <td style="width:28%;" class="rpt-meta">
                        <div><strong>Date From:</strong> <t t-esc="wiz.date_from"/></div>
                        <div><strong>Date To:</strong> <t t-esc="wiz.date_to"/></div>
                        <div><strong>Company:</strong> <t t-esc="company.name if company else ''"/></div>
                        <div><strong>Currency:</strong> <t t-esc="company.currency_id.name if company else ''"/></div>
                    </td>
                </tr>
            </table>

            <!-- ================= META STRIP ================= -->
            <table class="tbl-meta">
                <tr>
                    <td class="meta-lbl">Date From / من</td>
                    <td class="meta-val"><t t-esc="wiz.date_from"/></td>
                    <td class="meta-lbl">Date To / إلى</td>
                    <td class="meta-val"><t t-esc="wiz.date_to"/></td>
                    <td class="meta-lbl">Company / الشركة</td>
                    <td class="meta-val"><t t-esc="company.name if company else ''"/></td>
                    <td class="meta-lbl">Currency / العملة</td>
                    <td class="meta-val"><t t-esc="company.currency_id.name if company else ''"/></td>
                    <td class="meta-lbl">Scope / النطاق</td>
                    <td class="meta-val">Company Total / إجمالي الشركة</td>
                </tr>
            </table>

            <!-- ================= DATA TABLE ================= -->
            <table class="rpt-table">
                <thead>
                    <tr>
                        <th style="width:18%;">
                            <span class="th-en">Product</span>
                            <span class="th-ar">المنتج</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Opening Qty</span>
                            <span class="th-ar">رصيد افتتاحي (كمية)</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Opening Value</span>
                            <span class="th-ar">رصيد افتتاحي (قيمة)</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Incoming Qty</span>
                            <span class="th-ar">وارد الفترة (كمية)</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Incoming Value</span>
                            <span class="th-ar">وارد الفترة (قيمة)</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Outgoing Sales Qty</span>
                            <span class="th-ar">مبيعات (كمية)</span>
                        </th>
                        <th style="width:10%;">
                            <span class="th-en">Outgoing Sales Value</span>
                            <span class="th-ar">مبيعات (قيمة)</span>
                        </th>
                        <th style="width:11%;">
                            <span class="th-en">Closing Qty</span>
                            <span class="th-ar">رصيد ختامي (كمية)</span>
                        </th>
                        <th style="width:11%;">
                            <span class="th-en">Closing Value</span>
                            <span class="th-ar">رصيد ختامي (قيمة)</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="line">
                        <tr>
                            <td class="c-product">
                                <t t-esc="line['product_name']"/>
                                <span class="uom-hint"> (<t t-esc="line['uom']"/>)</span>
                            </td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['opening_qty'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['opening_val'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['incoming_qty'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['incoming_val'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['outgoing_qty'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['outgoing_val'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['closing_qty'])"/></td>
                            <td class="c-num"><t t-esc="'{:,.2f}'.format(line['closing_val'])"/></td>
                        </tr>
                    </t>
                    <t t-if="not lines">
                        <tr>
                            <td colspan="9" style="text-align:center; padding:14px; color:#888;">
                                No data found for the selected criteria.
                                <br/>
                                <span style="direction:rtl;">لا توجد بيانات للمعايير المحددة.</span>
                            </td>
                        </tr>
                    </t>
                </tbody>
                <tfoot>
                    <tr>
                        <td>TOTAL / الإجمالي</td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['opening_qty'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['opening_val'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['incoming_qty'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['incoming_val'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['outgoing_qty'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['outgoing_val'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['closing_qty'])"/></td>
                        <td class="c-num"><t t-esc="'{:,.2f}'.format(totals['closing_val'])"/></td>
                    </tr>
                </tfoot>
            </table>

            <!-- ================= FOOTER ================= -->
            <div class="rpt-footer">
                Company-Wide Inventory Report — All warehouses aggregated into Company Total.
                <br/>
                <span class="ar">تقرير المخزون على مستوى الشركة — جميع المخازن مجمعة في إجمالي الشركة.</span>
            </div>

        </div>
    </template>
</odoo>
