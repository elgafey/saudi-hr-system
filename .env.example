# ---------------------------------------------------------------------------
# Saudi HR Management System - environment template
# Copy to .env and fill in real values. .env is git-ignored. NEVER commit it.
# ---------------------------------------------------------------------------

# Application environment: development | staging | production
ENVIRONMENT=development

# Primary PostgreSQL connection (development default targets local PG 18).
# Production REQUIRES this variable to be set explicitly.
DATABASE_URL=postgresql+psycopg2://saudi_hr_user:<APP_PASSWORD>@127.0.0.1:5432/saudi_hr

# Optional: dedicated test database used by the automated test suite.
# If unset, tests derive saudi_hr_test from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg2://saudi_hr_user:<APP_PASSWORD>@127.0.0.1:5432/saudi_hr_test

# JWT signing secret. Production startup FAILS if this is missing, is the
# development default, shorter than 32 characters, or obviously low-entropy.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS origins for the frontend dev server (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistent local storage root for employee documents (Phase 2+)
STORAGE_PATH=./storage
